# PEW-DIY environment template — copy to .env and fill locally.
# NEVER commit .env (ignored). No real secrets in this file.

# PostgreSQL connection (dev DB; use a separate DB name for tests)
DATABASE_URL=postgresql://postgres@localhost:5432/pewdiy_dev
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/pewdiy_test

# HTTP
PORT=3000

# Session policy (SDS-OQ-02 decision D2: server session + cookie)
# idle: sliding expiry; absolute: hard cap from creation. Values in minutes.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=480
SESSION_COOKIE_NAME=pew_session
# Set to "true" only when serving over HTTPS (deployed)
SESSION_COOKIE_SECURE=false

# Seed credential inputs (local only; only salted hashes reach the DB)
# SEED_PASSWORD_BA=
# SEED_PASSWORD_BB=
# SEED_PASSWORD_CA=
