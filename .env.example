# PEW-DIY environment template — copy to .env and fill locally.
# NEVER commit .env (ignored). No real secrets in this file.

# ---------------------------------------------------------------------------
# PostgreSQL connection
# ---------------------------------------------------------------------------
# Application connection string (dev DB; use a separate DB name for tests).
DATABASE_URL=postgresql://postgres@localhost:5432/pewdiy_dev
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/pewdiy_test

# Docker Compose local database credentials (used by docker-compose.yml only).
# POSTGRES_PASSWORD has NO default and must stay EMPTY in this template: Compose
# rejects an unconfigured copy (fail closed) until you set a unique local value
# in your own .env before starting the stack. Use a value that is meaningful
# only on your machine; never reuse it anywhere.
POSTGRES_USER=pewdiy
POSTGRES_PASSWORD=
POSTGRES_DB=pewdiy

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
# Set NODE_ENV=production in the deployed production service.
NODE_ENV=development

# HTTP
PORT=3000

# Session policy (SDS-OQ-02 decision D2: server session + cookie)
# idle: sliding expiry; absolute: hard cap from creation. Values in minutes.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=480
SESSION_COOKIE_NAME=pew_session
# Set to "true" only when serving over HTTPS (deployed)
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Seeding (demo accounts + synthetic fixtures)
# ---------------------------------------------------------------------------
# Passwords are supplied privately per environment; only salted hashes reach
# the database. Leave empty in Git.
SEED_PASSWORD_BA=
SEED_PASSWORD_BB=
SEED_PASSWORD_CA=

# Optional explicit seed mode. Leave unset for normal operation.
# Production seeding is a two-step opt-in: the mode AND its matching CLI flag
# are both required, so an environment variable alone can never seed.
# - local-compose-demo: docker-compose migration container only;
#   requires `--local-compose-demo`.
# - cloud-demo: one-off Cloud Run seed job only;
#   requires `--cloud-demo`.
# NEVER set SEED_MODE on the long-running API service.
# SEED_MODE=

APP_ORIGIN=http://localhost:3000
# SDS-OQ-03: user-confirmed calendar policy for checkout +7 calendar days.
APP_TIMEZONE=Asia/Bangkok
